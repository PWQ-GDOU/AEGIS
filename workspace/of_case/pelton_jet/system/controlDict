FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
application     interFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.01;

deltaT          7.89e-5;

writeControl    adjustableRunTime;
writeInterval   0.001;
purgeWrite      0;
writeFormat     ascii;
writePrecision  6;

adjustTimeStep  yes;
maxCo           0.5;
maxAlphaCo      0.3;
maxDeltaT       2e-4;
