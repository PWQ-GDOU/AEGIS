FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
dimensions      [0 0 -1 0 0 0 0];
internalField   uniform 3267.01;
boundaryField
{
    inlet       { type fixedValue; value uniform 3267.01; }
    outlet      { type zeroGradient; }
    walls       { type omegaWallFunction; value uniform 3267.01; }
    atmosphere  { type inletOutlet; inletValue uniform 3267.01; value uniform 3267.01; }
}
