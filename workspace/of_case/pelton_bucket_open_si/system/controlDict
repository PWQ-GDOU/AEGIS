FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }
application simpleFoam;
startFrom latestTime;
startTime 0;
stopAt endTime;
endTime 3000;
deltaT 1;
writeControl timeStep;
writeInterval 100;
purgeWrite 3;
writeFormat ascii;
writePrecision 8;
runTimeModifiable true;
functions
{
    wallShearStress1 { type wallShearStress; libs (fieldFunctionObjects); writeControl writeTime; }
    residuals1 { type residuals; libs (utilityFunctionObjects); fields (U p k omega); writeControl timeStep; writeInterval 1; }
    bucketForces {
        type forces;
        libs (forces);
        patches (bucket);
        rhoInf 1000;
        rho rhoInf;
        CofR (0 0 0);
        writeControl timeStep;
        writeInterval 1;
    }
    inletFlux { type surfaceFieldValue; libs (fieldFunctionObjects); regionType patch; name inletFace; operation sum; fields (phi); writeFields false; writeControl timeStep; writeInterval 1; }
    jetFlux { type surfaceFieldValue; libs (fieldFunctionObjects); regionType patch; name jetInlet; operation sum; fields (phi); writeFields false; writeControl timeStep; writeInterval 1; }
    outletFlux { type surfaceFieldValue; libs (fieldFunctionObjects); regionType patch; name outletFace; operation sum; fields (phi); writeFields false; writeControl timeStep; writeInterval 1; }
    sideFlux { type surfaceFieldValue; libs (fieldFunctionObjects); regionType patch; name sides; operation sum; fields (phi); writeFields false; writeControl timeStep; writeInterval 1; }
}
