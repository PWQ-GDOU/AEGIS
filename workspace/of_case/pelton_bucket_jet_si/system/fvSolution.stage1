FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }
solvers {
    Phi { solver PCG; preconditioner DIC; tolerance 1e-8; relTol 0; }
    p { solver GAMG; smoother GaussSeidel; tolerance 1e-6; relTol 0.01; }
    U { solver smoothSolver; smoother GaussSeidel; tolerance 1e-6; relTol 0.1; }
    "(k|omega)" { solver smoothSolver; smoother GaussSeidel; tolerance 1e-6; relTol 0.1; }
}
SIMPLE { nNonOrthogonalCorrectors 3; residualControl { p 1e-4; U 1e-4; "(k|omega)" 1e-4; } }
relaxationFactors { fields { p 0.08; } equations { U 0.2; "(k|omega)" 0.2; } }
