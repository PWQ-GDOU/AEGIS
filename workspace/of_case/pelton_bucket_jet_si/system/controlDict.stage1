FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }
application simpleFoam;
startFrom startTime;
startTime 0;
stopAt endTime;
endTime 100;
deltaT 1;
writeControl timeStep;
writeInterval 100;
purgeWrite 1;
writeFormat ascii;
writePrecision 6;
runTimeModifiable true;
functions
{
    wallShearStress1 { type wallShearStress; libs (fieldFunctionObjects); writeControl writeTime; }
}
